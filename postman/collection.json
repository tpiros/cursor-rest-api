{
  "info": {
    "name": "REST API",
    "description": "Requests for the local REST API. Set baseUrl if the server is not on http://localhost:3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "GET /health"
      }
    },
    {
      "name": "List users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users?role=admin",
          "host": ["{{baseUrl}}"],
          "path": ["users"],
          "query": [
            {
              "key": "role",
              "value": "admin",
              "description": "Optional. Filter users by role (admin, user, moderator)."
            }
          ]
        },
        "description": "GET /users with optional role query parameter."
      }
    },
    {
      "name": "Get user",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/1",
          "host": ["{{baseUrl}}"],
          "path": ["users", "1"]
        },
        "description": "GET /users/:id"
      }
    },
    {
      "name": "Create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sam Taylor\",\n  \"email\": \"sam@example.com\",\n  \"role\": \"user\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": ["{{baseUrl}}"],
          "path": ["users"]
        },
        "description": "POST /users. name and email are required. role defaults to user when omitted."
      }
    },
    {
      "name": "List products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products?category=electronics&inStock=true",
          "host": ["{{baseUrl}}"],
          "path": ["products"],
          "query": [
            {
              "key": "category",
              "value": "electronics",
              "description": "Optional. Filter products by category (electronics, accessories, furniture)."
            },
            {
              "key": "inStock",
              "value": "true",
              "description": "Optional. When true, return only products that are in stock."
            }
          ]
        },
        "description": "GET /products with optional category and inStock query parameters."
      }
    },
    {
      "name": "Get product",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/1",
          "host": ["{{baseUrl}}"],
          "path": ["products", "1"]
        },
        "description": "GET /products/:id"
      }
    }
  ]
}
